# CLI: binaries, the test oracle, and fuzzing build/run products. The
# seed corpus under cli/fuzz/corpus/ is committed; fuzz runs write new
# inputs and any crashers to cli/fuzz/artifacts/ instead.
cli/hayasum
cli/tests/refhash
cli/fuzz/fuzz_args
cli/fuzz/fuzz_label
cli/fuzz/fuzz_stream
cli/fuzz/fuzz_stream_small
cli/fuzz/*-replay
cli/fuzz/artifacts/

# C install / pkg-config build products
hayahash.pc
.install-check/

# Differential conformance corpus (CI writes it to the workspace root)
hayahash-differential.bin

# CMake build and install-comparison directories
build/
consumer-build/
stage-cmake/
stage-make/

# C harness binaries
tests/bench
tests/quality
tests/hash128
test_vectors/generate
test_vectors/.generated.txt

# SMHasher3 harness: the pinned upstream clone (GPL-3.0, never vendored)
tests/smhasher3/smhasher3*/

# Wasm harness: build outputs and fetched competitor headers
tests/wasm/bench.wasm
tests/wasm/kat_haya
tests/wasm/kat_native
tests/wasm/kat_native.txt
tests/wasm/kat_wasm.txt
tests/wasm/rapidhash.h
tests/wasm/xxhash.h

# Website playground: artifacts assembled by scripts/build-playground.sh.
# bench.wasm embeds MIT and BSD-2 code (rapidhash, xxHash), so it is built at
# deploy time and never committed.
website/bench.wasm
website/vendor/
website/assets/
website/playground-assets.json

# Rust
rust/target/
rust/Cargo.lock

# Zig
zig/.zig-cache/
zig/zig-out/

# Java
java/target/

# .NET / C#
csharp/**/bin/
csharp/**/obj/
csharp/**/*.nupkg
csharp/**/*.snupkg

# MIPS64 assembly port build outputs
mips/kat
mips/*.o

# Python
python/**/__pycache__/
python/**/*.egg-info/
python/.eggs/
python/build/
python/dist/
python/.pytest_cache/
python/src/hayahash/*.so
python/src/hayahash/*.pyd

# Swift
swift/.build/
swift/.swiftpm/
swift/Packages/

# Paper build outputs
output/

# Claude and optimisation work
.claude
.optwork
